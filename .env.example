VITE_SOLANA_RPC_URL=https://devnet.rpcpool.com
# Required before opening a position. Use the deployed Soleil program address.
VITE_SOLEIL_PROGRAM_ID=
# Optional until the maker service is running. The local gateway listens here by default.
VITE_SOLEIL_QUOTES_URL=http://127.0.0.1:8787/quotes
# Optional; when omitted, the app derives /settle from VITE_SOLEIL_QUOTES_URL.
# VITE_SOLEIL_SETTLEMENT_URL=http://127.0.0.1:8787/settle

# Maker gateway settings. Keep these out of the Vite client environment.
# SOLEIL_RPC_URL=https://devnet.rpcpool.com
# SOLEIL_PROGRAM_ID=<deployed program public key>
# SOLEIL_MAKER_KEYPAIR=C:\\path\\to\\maker-keypair.json
# SOLEIL_MARKET_LIQUIDITY_LAMPORTS=5000000000
# SOLEIL_QUOTE_SIZE_LAMPORTS=1000000000
# SOLEIL_COLLATERAL_LAMPORTS_PER_SOL=1000000000
# SOLEIL_QUOTE_TTL_SECONDS=90
